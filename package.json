{
  "name": "cypress-test",
  "version": "1.1.0",
  "description": "A repo to explore visual, functional, and accessibility testing in Cypress",
  "main": "index.js",
  "scripts": {
    "start": "http-server ./public/sitewide-a11y -a 127.0.0.1 -p 8080 -c-1 -d false",
    "cypress:ci": "start-server-and-test start 8080 cypress:run:chrome",
    "cypress:dev": "start-server-and-test start 8080 cypress:open",
    "cypress:open": "cypress open",
    "cypress:run:chrome": "cypress run --browser chrome",
    "lint": "tsc --noEmit --pretty -p cypress && tsc --noEmit --pretty -p . && tsc --pretty -p test",
    "test:unit": "node --experimental-strip-types --no-warnings --test 'test/**/*.test.ts'",
    "cypress:run": "cypress run"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Copenut/cypress-test.git"
  },
  "keywords": [
    "cypress",
    "end-to-end",
    "testing",
    "accessibility",
    "docker"
  ],
  "author": "Trevor Pierce",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/1Copenut/cypress-test/issues"
  },
  "homepage": "https://github.com/1Copenut/cypress-test#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "cypress": "^16.2.1",
    "cypress-axe": "^1.7.0",
    "cypress-real-events": "^1.15.1",
    "http-server": "^14.1.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "cypress-axe": {
      "cypress": "$cypress"
    }
  },
  "engines": {
    "node": ">=22.6"
  }
}
